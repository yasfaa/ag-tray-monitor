<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Antigravity Quota Monitor"
        Width="380" Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True">
    
    <Window.Resources>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12" Background="#0F172A" CornerRadius="12" BorderBrush="#1E293B" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Color="#000000" Direction="270" Opacity="0.5" ShadowDepth="6"/>
        </Border.Effect>

        <Grid Margin="18,16,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- User card -->
                <RowDefinition Height="*"/>    <!-- Quota cards -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Name="imgAppIcon" Grid.Column="0" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Antigravity Quota" Foreground="#F8FAFC" FontSize="14" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Ellipse Name="dotStatus" Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Name="txtStatus" Text="Connected" Foreground="#94A3B8" FontSize="11" FontWeight="Medium"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="btnRefresh" Style="{StaticResource HeaderButton}" Content="Refresh" Margin="0,0,6,0"/>
                    <Button Name="btnClose" Style="{StaticResource HeaderButton}" Content="Close"/>
                </StackPanel>
            </Grid>

            <!-- USER PROFILE CARD -->
            <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="12,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Name="txtUserName" Text="User" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Name="txtUserEmail" Text="Local Service" Foreground="#94A3B8" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#2563EB" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Name="txtPlanBadge" Text="PRO" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- QUOTA GROUPS -->
            <StackPanel Grid.Row="2">
                <!-- GEMINI CARD -->
                <Border Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Gemini Models" Foreground="#60A5FA" FontSize="12.5" FontWeight="SemiBold"/>
                            <TextBlock Text="Flash, Pro" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- 5h limit -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="5-Hour Limit" Foreground="#CBD5E1" FontSize="11"/>
                            <TextBlock Name="txtGemini5hPct" Text="100%" Foreground="#34D399" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="6" Background="#0F172A" CornerRadius="3" Margin="0,0,0,4">
                            <Border Name="barGemini5h" HorizontalAlignment="Left" Background="#10B981" CornerRadius="3" Width="0"/>
                        </Border>
                        <TextBlock Name="txtGemini5hReset" Text="Resets in 4h 49m" Foreground="#94A3B8" FontSize="10.5" Margin="0,0,0,10"/>

                        <!-- Weekly limit -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Weekly Limit" Foreground="#CBD5E1" FontSize="11"/>
                            <TextBlock Name="txtGeminiWkPct" Text="100%" Foreground="#34D399" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="6" Background="#0F172A" CornerRadius="3" Margin="0,0,0,4">
                            <Border Name="barGeminiWk" HorizontalAlignment="Left" Background="#10B981" CornerRadius="3" Width="0"/>
                        </Border>
                        <TextBlock Name="txtGeminiWkReset" Text="Resets in 1d 3h" Foreground="#94A3B8" FontSize="10.5"/>
                    </StackPanel>
                </Border>

                <!-- CLAUDE & GPT CARD -->
                <Border Background="#1E293B" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Claude and GPT Models" Foreground="#C084FC" FontSize="12.5" FontWeight="SemiBold"/>
                            <TextBlock Text="Sonnet, Opus, GPT" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- 5h limit -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="5-Hour Limit" Foreground="#CBD5E1" FontSize="11"/>
                            <TextBlock Name="txtClaude5hPct" Text="100%" Foreground="#34D399" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="6" Background="#0F172A" CornerRadius="3" Margin="0,0,0,4">
                            <Border Name="barClaude5h" HorizontalAlignment="Left" Background="#10B981" CornerRadius="3" Width="0"/>
                        </Border>
                        <TextBlock Name="txtClaude5hReset" Text="Resets in 4h 58m" Foreground="#94A3B8" FontSize="10.5" Margin="0,0,0,10"/>

                        <!-- Weekly limit -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Weekly Limit" Foreground="#CBD5E1" FontSize="11"/>
                            <TextBlock Name="txtClaudeWkPct" Text="100%" Foreground="#34D399" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="6" Background="#0F172A" CornerRadius="3" Margin="0,0,0,4">
                            <Border Name="barClaudeWk" HorizontalAlignment="Left" Background="#10B981" CornerRadius="3" Width="0"/>
                        </Border>
                        <TextBlock Name="txtClaudeWkReset" Text="Resets in 6d 23h" Foreground="#94A3B8" FontSize="10.5"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- FOOTER -->
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Name="txtLastUpdated" Text="Updated: Just now" Foreground="#94A3B8" FontSize="10.5"/>
                    <TextBlock Text="Auto-refresh: 60s" Foreground="#64748B" FontSize="10" Margin="0,1,0,0"/>
                </StackPanel>

                <CheckBox Name="chkAutoStart" Grid.Column="1" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11" Content="Start with Windows" Cursor="Hand"/>
            </Grid>
        </Grid>
    </Border>
</Window>
